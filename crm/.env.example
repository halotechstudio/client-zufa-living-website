# ZUFA CRM settings.
# Copy this file to a new file called .env (in the same crm folder) and fill in the values.
# The .env file is never uploaded to GitHub. On Render, enter the same names and values
# under the service's "Environment" tab instead.

# --- Dashboard login ---------------------------------------------------------
# Password for the "admin" account. Use a long one (12+ characters).
ADMIN_PASSWORD=

# --- Meta (Facebook / Instagram) Lead Ads ------------------------------------
# From developers.facebook.com → your app → App settings → Basic
META_APP_ID=
META_APP_SECRET=
# Any phrase you make up. Type the exact same phrase into Meta's Webhooks screen.
META_VERIFY_TOKEN=
# The ZUFA Living Facebook Page's numeric ID (Page → About → Page transparency, or Graph API Explorer)
META_PAGE_ID=
# Long-lived Page access token (see README, step 5). Starts with EAA...
META_PAGE_ACCESS_TOKEN=

# --- Optional ----------------------------------------------------------------
# Website(s) allowed to send their enquiry form to this CRM (comma separated)
SITE_ORIGINS=https://halotechstudio.github.io
# Where the database file lives. On Render, set this to your disk's mount path, e.g. /var/data
DATA_DIR=./data
PORT=3000
TIMEZONE=Asia/Kolkata
GRAPH_API_VERSION=v26.0
# How often (minutes) the CRM double-checks Meta for leads the webhook may have missed. 0 = never.
SYNC_INTERVAL_MINUTES=60
