# ZUFA CRM settings.
# On Vercel: enter these under the zufa-crm project → Settings → Environment Variables, then redeploy.
# Locally: copy this file to a new file called .env (in the crm folder) and fill in the values.
# The .env file is never uploaded to GitHub.

# --- Database -------------------------------------------------------------------
# Added for you when you connect Neon to the project in Vercel (Storage → Neon).
# Leave empty locally to use a built-in local database (PGlite) stored in DATA_DIR.
DATABASE_URL=

# --- Dashboard login ------------------------------------------------------------
# Password for the "admin" account. Use a long one (12+ characters).
ADMIN_PASSWORD=

# --- Scheduled check (Vercel Cron) ----------------------------------------------
# Any long random string. Vercel sends it with each scheduled call; others are refused.
CRON_SECRET=

# --- Meta (Facebook / Instagram) Lead Ads ---------------------------------------
# From developers.facebook.com → your app → App settings → Basic
META_APP_ID=
META_APP_SECRET=
# Any phrase you make up. Type the exact same phrase into Meta's Webhooks screen.
META_VERIFY_TOKEN=
# The ZUFA Living Facebook Page's numeric ID (see README, step 4)
META_PAGE_ID=
# Long-lived Page access token (see README, step 4). Starts with EAA...
META_PAGE_ACCESS_TOKEN=

# --- Optional -------------------------------------------------------------------
# Website address(es) allowed to send their enquiry form to this CRM (comma separated, no trailing slash)
SITE_ORIGINS=https://halotechstudio.github.io
TIMEZONE=Asia/Kolkata
GRAPH_API_VERSION=v26.0
# The dashboard runs a catch-up check with Meta when opened, at most this often (minutes). 0 = never.
SYNC_INTERVAL_MINUTES=60
# Local runs only
DATA_DIR=./data
PORT=3000
